# SmartShield AI showcase — everything works with NO env vars (the simulation
# runs in the browser). The settings below are optional.

# Optional: persist attack incidents to Supabase (see README "Supabase (optional)").
# Create the `incidents` table with the SQL in the README, then set:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: show the small "Interactive showcase build" note in page footers (default: true)
NEXT_PUBLIC_SHOWCASE_NOTE=true
